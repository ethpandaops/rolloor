#!/usr/bin/env bash
# Asks the updater to deploy the tag's head only if it matches the requested
# digest. A moving tag leaves the container alone until the next registry poll
# replaces the rollout.
set -euo pipefail
source "$(dirname "$0")/lib.sh" || exit 3

target=$(cat)
name=$(jq -r .extra.container <<<"$target")
desired=$(jq -r .desired <<<"$target")

list=$(updater_get "/v1/containers?name=${name}") || answer 3 "updater unreachable"
current=$(container_field "$list" digest)
[ "$current" != "$desired" ] || answer 0 "already running $(short "$desired")"

check=$(updater_post "/v1/check?container=${name}") || answer 3 "updater unreachable"
err=$(container_field "$check" error)
if [ -n "$err" ] && [ "$err" != null ]; then
  answer 3 "updater could not read the registry: $err"
fi

head=$(container_field "$check" latest_digest)
[ "$head" = "$desired" ] || answer 0 "tag head is $(short "$head"), not $(short "$desired"); left as is"

# Async: the updater takes it and restarts the container in the background;
# rolloor then watches inspect for the digest.
updater_post "/v1/update?container=${name}&async=true" >/dev/null || answer 3 "updater unreachable"
echo "update to $(short "$desired") started"
