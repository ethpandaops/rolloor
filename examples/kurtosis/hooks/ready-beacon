#!/usr/bin/env bash
# Ready when the beacon node is synced and its execution client is online.
set -euo pipefail
source "$(dirname "$0")/lib.sh" || exit 3

target=$(cat)
beacon=$(jq -r .extra.beacon <<<"$target")

s=$(curl -fsS --max-time 10 "$beacon/eth/v1/node/syncing") || unreachable "beacon API"
syncing=$(jq -r .data.is_syncing <<<"$s")
offline=$(jq -r .data.el_offline <<<"$s")

case $syncing in
  true) answer 1 "syncing, $(jq -r .data.sync_distance <<<"$s") slots behind" ;;
  false) ;;
  *) answer 3 "beacon API gave no sync status" ;;
esac

case $offline in
  true) answer 1 "execution client offline" ;;
  false) ;;
  *) answer 3 "beacon API gave no execution client status" ;;
esac

echo "synced at slot $(jq -r .data.head_slot <<<"$s")"
