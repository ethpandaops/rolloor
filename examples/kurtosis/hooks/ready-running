#!/usr/bin/env bash
# Ready when the container is running. For containers with no API of their
# own, such as validator clients.
set -euo pipefail
source "$(dirname "$0")/lib.sh" || exit 3

target=$(cat)
name=$(jq -r .extra.container <<<"$target")

state=$(container_state) || answer 3 "the updater gives no clear answer"
[ "$state" = running ] || answer 1 "$name is $state"

echo "$name running"
