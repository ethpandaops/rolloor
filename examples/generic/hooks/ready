#!/usr/bin/env bash
# The container answers 200 on its port. When it does not answer, docker says
# whether that is a no (the container is gone or stopped) or unknown (it runs).
set -euo pipefail
source "$(dirname "$0")/lib.sh" || exit 3

target=$(cat)
service=$(jq -r '.extra.service // empty' <<<"$target")
port=$(jq -r '.extra.port // empty' <<<"$target")
[ -n "$service" ] && [ -n "$port" ] || answer 3 "the target has no extra.service or extra.port"

check "$service" "$port"
answer "$verdict" "$why"
