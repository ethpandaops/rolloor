#!/usr/bin/env bash
# The updated containers answer at least as reliably as the ones not yet
# reached, or all answer when none remain. A container on either side that
# cannot be counted leaves the comparison unknown.
set -euo pipefail
source "$(dirname "$0")/lib.sh" || exit 3

input=$(cat)

# rate SIDE: sets pct to the share of SIDE's targets answering 200, or -1 when
# SIDE has none.
rate() {
  local rows id service port ok=0 n=0
  rows=$(jq -r --arg side "$1" '.[$side][]? | [.id, .extra.service, .extra.port] | @tsv' <<<"$input")

  while IFS=$'\t' read -r id service port; do
    [ -n "$id" ] || continue
    [ -n "$service" ] && [ -n "$port" ] || answer 3 "$1 target $id has no extra.service or extra.port"
    check "$service" "$port"
    [ "$verdict" != 3 ] || answer 3 "$1 target $id: $why"
    n=$((n + 1))
    [ "$verdict" != 0 ] || ok=$((ok + 1))
  done <<<"$rows"

  if [ "$n" -eq 0 ]; then pct=-1; else pct=$((ok * 100 / n)); fi
}

rate updated
updated=$pct
rate remaining
remaining=$pct

if [ "$remaining" = "-1" ]; then
  remaining=100
fi

reason="updated ${updated}% ok, remaining ${remaining}% ok"
numbers="updated=${updated} remaining=${remaining} unit=%"

[ "$updated" -ge "$remaining" ] || answer 1 "$reason" "$numbers"
answer 0 "$reason" "$numbers"
