#!/usr/bin/env bash
# Prints the digest the container is running, as the registry names it: the
# container's image id, then that image's repository digest.
set -euo pipefail

target=$(cat)
service=$(jq -r .extra.service <<<"$target")
container="rolloor-example-${service}-1"

image=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null) || {
  echo "container $container not found"
  exit 1
}

repo_digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "$image" 2>/dev/null) || {
  echo "image $image has no repository digest"
  exit 1
}

echo "${repo_digest##*@}"
