# rolloor for one ethpandaops devnet. The targets file comes from
# targets.yaml.j2; the teams file from `rolloor-ethpandaops teams`.
environment: glamsterdam-devnet-11
listen: ":8080"
dataDir: /var/lib/rolloor
targetsDir: /etc/rolloor/targets.d
teamsFile: /etc/rolloor/teams.yaml

labels:
  group: client
  owner: owner
  section: role
  hiddenGroups: [xatu-sentry]

registry:
  poll: 60s
  authFile: /etc/rolloor/registry-auth.json

budget: 10%

hooks:
  # The image links every rolloor-ethpandaops program here.
  dir: /usr/local/share/rolloor/ethpandaops
  timeout: 60s
  defaults:
    inspect: inspect
    update: update
    ready: ready-running
    soak: ""
  environment:
    program: environment
    interval: 30s

inspect:
  interval: 30s
  concurrency: 16
  unknownAfter: 3

# Soaks run at least three epochs so the validator soak (two epochs back)
# sees the updated batch.
presets:
  careful: {batch: [1, 10%], soak: {duration: 20m, interval: 2m, passes: 3, grace: 1}, pauseAfterFirst: true}
  normal:  {batch: [10%],    soak: {duration: 20m, interval: 2m, passes: 3, grace: 1}}
  fast:    {batch: [50%],    soak: {duration: 0s}}
  all:     {batch: [100%],   soak: {duration: 0s}, waves: false}
defaultPolicy: {mode: automated, speed: careful}

auth:
  mode: oidc
  issuer: https://auth.ethpandaops.io/application/o/rolloor/
  clientId: rolloor
  clientSecretEnv: ROLLOOR_OIDC_CLIENT_SECRET
  sessionSecretEnv: ROLLOOR_SESSION_SECRET
  redirectUrl: https://rolloor.glamsterdam-devnet-11.ethpandaops.io/auth/callback
  identityClaim: preferred_username
  adminOwner: operators
